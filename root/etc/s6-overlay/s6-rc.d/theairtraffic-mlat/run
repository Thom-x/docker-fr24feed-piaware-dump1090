#!/command/with-contenv bash

if [ "$SERVICE_ENABLE_THEAIRTRAFFIC" != "false" ]; then

    default_value() {
        key=${1//\-/_DASH_}
        key=THEAIRTRAFFIC_${key^^}
        eval "value=\${$key:-\$2}"
        printf -v $key -- "$value"
        export $key
    }

    default_value "mlat" "true"

    if [ "$THEAIRTRAFFIC_MLAT" == "no" ] || [ "$THEAIRTRAFFIC_MLAT" == "false" ]; then
        tail -f /dev/null
        exit 0
    fi

    set -eo pipefail

    MLAT_ALTITUDE_MSL_METERS="$(echo "${MLAT_ALTITUDE_MSL_METERS}" | tr --delete ' m')"

    if [ -z "$MLAT_EXACT_LAT" ] || [ -z "$MLAT_EXACT_LON" ] || [ -z "$MLAT_ALTITUDE_MSL_METERS" ] || [ -z "$THEAIRTRAFFIC_STATION_NAME" ]; then
        for i in {1..5}; do
            echo "FATAL: MLAT_EXACT_LAT or MLAT_EXACT_LON or MLAT_ALTITUDE_MSL_METERS or THEAIRTRAFFIC_STATION_NAME not set!" | mawk -W interactive '{printf "%c[35m[theairtraffic-conf]%c[31m %s\n", 27, 27, $0}'
        done
        kill 1
        exit 1
    fi
    # pushes MLAT results into dump1090 via port 30104
    # listens on 31023 to provide MLAT results as SBS / basestation
    # listens on 30197 to provide MLAT results as beast
    # pushes MLAT results into theairtraffic-feed
    /usr/local/share/adsbexchange/venv/bin/mlat-client \
        --input-type dump1090 --no-udp \
        --input-connect 127.0.0.1:30005 \
        --server feed.theairtraffic.com:31090 \
        --lat "${MLAT_EXACT_LAT}" --lon "${MLAT_EXACT_LON}" \
        --alt "${MLAT_ALTITUDE_MSL_METERS}" \
        --user "${THEAIRTRAFFIC_STATION_NAME}" \
        --uuid-file /usr/local/share/theairtraffic/theairtraffic-uuid \
        --results beast,connect,127.0.0.1:30104 \
        --results basestation,listen,31023 \
        --results beast,listen,30197 \
        --results beast,connect,127.0.0.1:30199 \
        2>&1 | mawk -W interactive '{printf "%c[35m[theairtraffic-mlat]%c[0m %s\n", 27, 27, $0}'
    # awk -W interactive ...  (prefix log messages with color and "[theairtraffic-mlat]")
else
    tail -f /dev/null
fi
